<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Top Playful App Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_launcher_round" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="@string/app_name"
                android:textColor="@color/primary"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/tvHeaderSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tap_to_listen"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- 3 Category Navigation Tabs (3 Posisi) -->
    <LinearLayout
        android:id="@+id/layoutCategoryTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <!-- Tab 1: Hewan -->
        <LinearLayout
            android:id="@+id/tabAnimal"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageView
                android:id="@+id/iconTabAnimal"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_tab_animal"
                app:tint="@color/tab_inactive_text" />

            <TextView
                android:id="@+id/textTabAnimal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-bold"
                android:text="@string/category_animal"
                android:textColor="@color/tab_inactive_text"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Tab 2: Kendaraan -->
        <LinearLayout
            android:id="@+id/tabVehicle"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageView
                android:id="@+id/iconTabVehicle"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_tab_vehicle"
                app:tint="@color/tab_inactive_text" />

            <TextView
                android:id="@+id/textTabVehicle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-bold"
                android:text="@string/category_vehicle"
                android:textColor="@color/tab_inactive_text"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Tab 3: Alat Musik -->
        <LinearLayout
            android:id="@+id/tabMusic"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageView
                android:id="@+id/iconTabMusic"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_tab_music"
                app:tint="@color/tab_inactive_text" />

            <TextView
                android:id="@+id/textTabMusic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-bold"
                android:text="@string/category_music"
                android:textColor="@color/tab_inactive_text"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Sound Items Grid (10 items per category) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSoundItems"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="16dp"
        tools:listitem="@layout/item_sound_card" />

</LinearLayout>

